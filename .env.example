# P3 AI Assessment Platform - Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from your Supabase project settings: Settings > API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# AZURE AD / ENTRA ID CONFIGURATION
# =============================================================================
# Get these from Azure Portal: Azure Active Directory > App Registrations

# Application (client) ID
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id

# Directory (tenant) ID (use 'common' for multi-tenant)
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id

# Redirect URI (must match Azure AD app registration)
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=http://localhost:3000

# Post-logout redirect URI
NEXT_PUBLIC_AZURE_AD_POST_LOGOUT_URI=http://localhost:3000

# =============================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# =============================================================================

# Application URL (for production)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Enable debug logging
# NEXT_PUBLIC_DEBUG=false
